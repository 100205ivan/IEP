{
  "name": "eyeep-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:iep-pdf": "tsx --test src/tests/iepPdfExport.test.ts",
    "check:word-layout": "tsx src/scripts/checkWordLayout.ts",
    "test:education-summary": "tsx --test src/tests/educationSummary.test.ts",
    "test:domain-analysis": "tsx --test src/tests/domainAnalysis.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "diagnose:gemini": "tsx src/scripts/diagnoseGemini.ts",
    "diagnose:gemini:json-mime": "tsx src/scripts/diagnoseGeminiStructured.ts json-mime",
    "diagnose:gemini:json-schema": "tsx src/scripts/diagnoseGeminiStructured.ts json-schema",
    "diagnose:gemini:structured": "tsx src/scripts/diagnoseGeminiStructured.ts structured",
    "diagnose:gemini:document-schema": "tsx src/scripts/diagnoseGeminiStructured.ts document",
    "diagnose:gemini:domain-schema": "tsx src/scripts/diagnoseGeminiStructured.ts domain",
    "diagnose:gemini:document-d1": "tsx src/scripts/diagnoseGeminiPayloadSize.ts document-d1",
    "diagnose:gemini:document-d2": "tsx src/scripts/diagnoseGeminiPayloadSize.ts document-d2",
    "diagnose:gemini:document-d4": "tsx src/scripts/diagnoseGeminiPayloadSize.ts document-d4",
    "diagnose:gemini:domain-a1": "tsx src/scripts/diagnoseGeminiPayloadSize.ts domain-a1",
    "diagnose:gemini:domain-a2": "tsx src/scripts/diagnoseGeminiPayloadSize.ts domain-a2",
    "diagnose:gemini:domain-a3": "tsx src/scripts/diagnoseGeminiPayloadSize.ts domain-a3",
    "diagnose:gemini:domain-a4": "tsx src/scripts/diagnoseGeminiPayloadSize.ts domain-a4",
    "test:gemini-document-analysis": "tsx src/tests/geminiDocumentAnalysis.integration.ts",
    "test:assessments": "tsx --test src/tests/assessmentRecords.integration.ts",
    "test:attention": "tsx --test src/tests/attentionReport.test.ts",
    "test:support-services": "tsx --test src/tests/supportServices.integration.ts",
    "test:inclusive-education": "tsx --test src/tests/inclusiveEducationPlan.test.ts",
    "test:curriculum-schedule": "tsx --test src/tests/curriculumSchedule.test.ts",
    "test:education-goals": "tsx --test src/tests/educationGoals.test.ts",
    "test:behavior-transition": "tsx --test src/tests/behaviorTransition.test.ts",
    "test:iep-meetings": "tsx --test src/tests/iepMeetingRecords.test.ts",
    "test:chapter-migration": "tsx --test src/tests/iepChapterContent.test.ts src/tests/iepChapterMigration.test.ts",
    "test:chapter-storage": "tsx --test src/tests/iepChapterStorage.integration.ts",
    "test:unused-columns": "tsx --test src/tests/unusedColumnMigration.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mysql2": "^3.15.3",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
